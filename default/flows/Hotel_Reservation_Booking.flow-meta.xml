        <name>sendConfirmationEmail</name>
        <label>Send Confirmation Email</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>confirmationScreen</targetReference>
        </connector>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>varEmail</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>Your Azure Sanctuary Reservation — {!varConfirmationCode}</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <stringValue>Dear {!varFirstName},

Thank you for choosing The Azure Sanctuary.

Your reservation has been confirmed.

Confirmation Code: {!varConfirmationCode}
Room: {!varRoomName}
Check-in: {!varCheckInDate}
Check-out: {!varCheckOutDate}
Guests: {!varGuests}

We look forward to welcoming you.

Warm regards,
The Azure Sanctuary Team</stringValue>
            </value>
        </inputParameters>
    </actionCalls>

