            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Confirmed</stringValue>
            </value>
        </inputAssignments>
        <object>Hotel_Reservation__c</object>
    </recordCreates>

    <!-- ══════════════════════════════════════════════════════════════════
         ACTION — Send confirmation email
         ══════════════════════════════════════════════════════════════════ -->
