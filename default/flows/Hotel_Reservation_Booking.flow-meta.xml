&lt;p&gt;Dear {!varFirstName}, your reservation at The Azure Sanctuary has been confirmed.&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Confirmation Code:&lt;/strong&gt; {!varConfirmationCode}&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Room:&lt;/strong&gt; {!varRoomName}&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Check-in:&lt;/strong&gt; {!varCheckInDate}&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Check-out:&lt;/strong&gt; {!varCheckOutDate}&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Guests:&lt;/strong&gt; {!varGuests}&lt;/p&gt;
&lt;p&gt;A confirmation email has been sent to {!varEmail}.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Done</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

