    <!-- ══════════════════════════════════════════════════════════════════
         SCREEN 2 — Payment Details
         ══════════════════════════════════════════════════════════════════ -->
    <screens>
        <name>paymentDetailsScreen</name>
        <label>Payment</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <backButtonLabel>Back</backButtonLabel>
        <connector>
            <targetReference>generateConfirmationCode</targetReference>
        </connector>
        <fields>
            <name>paymentDetailsHeader</name>
            <fieldText>&lt;h2 style=&quot;font-family: Cormorant Garamond, serif; font-size: 1.6rem; color: #1a1714;&quot;&gt;Payment&lt;/h2&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>varPaymentMethod</name>
            <choiceReferences>choicePaymentCard</choiceReferences>
            <choiceReferences>choicePaymentTransfer</choiceReferences>
            <dataType>String</dataType>
            <defaultSelectedChoiceReference>choicePaymentCard</defaultSelectedChoiceReference>
            <fieldText>Payment Method</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>varCardholderName</name>
            <dataType>String</dataType>
            <fieldText>Cardholder Name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>varCardNumber</name>
            <dataType>String</dataType>
            <fieldText>Card Number</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <validationRule>
                <errorMessage>Please enter a valid 13–16 digit card number.</errorMessage>
                <formulaExpression>AND({!varPaymentMethod} = &apos;card&apos;, OR(LEN(SUBSTITUTE({!varCardNumber}, &apos; &apos;, &apos;&apos;)) &lt; 13, LEN(SUBSTITUTE({!varCardNumber}, &apos; &apos;, &apos;&apos;)) &gt; 16))</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>varCardExpiry</name>
            <dataType>String</dataType>
            <fieldText>Expiry Date (MM/YY)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <validationRule>
                <errorMessage>Enter a valid expiry date in MM/YY format with a future expiry.</errorMessage>
                <formulaExpression>AND({!varPaymentMethod} = &apos;card&apos;, OR(NOT(REGEX({!varCardExpiry}, &apos;^\\d{2}/\\d{2}$&apos;)), VALUE(RIGHT({!varCardExpiry}, 2)) + 2000 &lt; YEAR(TODAY()), AND(VALUE(RIGHT({!varCardExpiry}, 2)) + 2000 = YEAR(TODAY()), VALUE(LEFT({!varCardExpiry}, 2)) &lt; MONTH(TODAY()))))</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>varCardCVV</name>
            <dataType>String</dataType>
            <fieldText>CVV</fieldText>
            <fieldType>PasswordField</fieldType>
            <isRequired>true</isRequired>
            <validationRule>
                <errorMessage>Enter a valid 3 or 4 digit CVV.</errorMessage>
                <formulaExpression>AND({!varPaymentMethod} = &apos;card&apos;, OR(LEN({!varCardCVV}) &lt; 3, LEN({!varCardCVV}) &gt; 4))</formulaExpression>
            </validationRule>
        </fields>
        <nextOrFinishButtonLabel>Complete Reservation</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <!-- ══════════════════════════════════════════════════════════════════
         FORMULA — Generate confirmation code
         ══════════════════════════════════════════════════════════════════ -->
    <formulas>
        <name>formulaConfirmationCode</name>
        <dataType>String</dataType>
        <expression>&apos;AZR-&apos; &amp; SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(TEXT({!$Flow.CurrentDateTime}), &apos;-&apos;, &apos;&apos;), &apos;:&apos;, &apos;&apos;), &apos; &apos;, &apos;&apos;)</expression>
    </formulas>

    <!-- ══════════════════════════════════════════════════════════════════
         ASSIGNMENT — Set confirmation code variable
         ══════════════════════════════════════════════════════════════════ -->
    <assignments>
        <name>generateConfirmationCode</name>
        <label>Generate Confirmation Code</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <assignmentItems>
            <assignToReference>varConfirmationCode</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formulaConfirmationCode</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>createReservationRecord</targetReference>
        </connector>
    </assignments>

