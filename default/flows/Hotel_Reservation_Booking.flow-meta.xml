<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <description>Screen flow that guides a guest through The Azure Sanctuary hotel reservation process: guest details, payment, record creation, and booking confirmation.</description>
    <interviewLabel>Hotel Reservation Booking {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Hotel Reservation Booking</label>
